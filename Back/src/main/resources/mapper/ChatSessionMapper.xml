<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nian.yinianzhida.mapper.ChatSessionMapper">

    <resultMap id="BaseResultMap" type="com.nian.yinianzhida.entity.ChatSession">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="session_type" property="sessionType"/>
        <result column="resume_id" property="resumeId"/>
        <result column="title" property="title"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 根据ID查询会话 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM chat_session WHERE id = #{id}
    </select>

    <!-- 根据用户ID查询会话列表 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT * FROM chat_session WHERE user_id = #{userId} ORDER BY updated_at DESC
    </select>

    <!-- 根据用户ID和简历ID查询最新的会话 -->
    <select id="selectLatestByUserIdAndResumeId" resultMap="BaseResultMap">
        SELECT * FROM chat_session
        WHERE user_id = #{userId} AND resume_id = #{resumeId} AND status = 1
        ORDER BY updated_at DESC
        LIMIT 1
    </select>

    <!-- 插入新会话 -->
    <insert id="insert" parameterType="com.nian.yinianzhida.entity.ChatSession" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_session (
            user_id,
            session_type,
            resume_id,
            title,
            status,
            created_at,
            updated_at
        ) VALUES (
            #{userId},
            #{sessionType},
            #{resumeId},
            #{title},
            #{status},
            NOW(),
            NOW()
        )
    </insert>

    <!-- 更新会话 -->
    <update id="updateById" parameterType="com.nian.yinianzhida.entity.ChatSession">
        UPDATE chat_session
        <set>
            <if test="title != null">title = #{title},</if>
            <if test="status != null">status = #{status},</if>
            updated_at = NOW()
        </set>
        WHERE id = #{id}
    </update>

    <!-- 更新会话状态 -->
    <update id="updateStatus">
        UPDATE chat_session
        SET status = #{status}, updated_at = NOW()
        WHERE id = #{id}
    </update>

</mapper>
