<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nian.yinianzhida.mapper.ResumeMapper">

    <!-- 完整的结果映射（包含file_data） -->
    <resultMap id="BaseResultMap" type="com.nian.yinianzhida.entity.Resume">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="file_name" property="fileName"/>
        <result column="file_type" property="fileType"/>
        <result column="file_size" property="fileSize"/>
        <result column="file_data" property="fileData"/>
        <result column="extracted_text" property="extractedText"/>
        <result column="is_default" property="isDefault"/>
        <result column="parse_status" property="parseStatus"/>
        <result column="parse_error" property="parseError"/>
        <result column="parsed_data" property="parsedData"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 列表查询的结果映射（不包含file_data，减少数据传输） -->
    <resultMap id="ListResultMap" type="com.nian.yinianzhida.entity.Resume">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="file_name" property="fileName"/>
        <result column="file_type" property="fileType"/>
        <result column="file_size" property="fileSize"/>
        <result column="is_default" property="isDefault"/>
        <result column="parse_status" property="parseStatus"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <!-- 插入新简历 -->
    <insert id="insert" parameterType="com.nian.yinianzhida.entity.Resume" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO resume (
            user_id,
            title,
            file_name,
            file_type,
            file_size,
            file_data,
            extracted_text,
            is_default,
            parse_status,
            parse_error,
            parsed_data
        ) VALUES (
            #{userId},
            #{title},
            #{fileName},
            #{fileType},
            #{fileSize},
            #{fileData},
            #{extractedText},
            #{isDefault},
            #{parseStatus},
            #{parseError},
            #{parsedData}
        )
    </insert>

    <!-- 根据ID查询简历（包含file_data） -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT
            id,
            user_id,
            title,
            file_name,
            file_type,
            file_size,
            file_data,
            extracted_text,
            is_default,
            parse_status,
            parse_error,
            parsed_data,
            created_at,
            updated_at
        FROM resume
        WHERE id = #{id}
    </select>

    <!-- 根据用户ID查询所有简历（包含file_data） -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT
            id,
            user_id,
            title,
            file_name,
            file_type,
            file_size,
            file_data,
            extracted_text,
            is_default,
            parse_status,
            parse_error,
            parsed_data,
            created_at,
            updated_at
        FROM resume
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- 根据用户ID查询简历列表（不包含file_data，用于列表展示） -->
    <select id="selectListByUserId" resultMap="ListResultMap">
        SELECT
            id,
            user_id,
            title,
            file_name,
            file_type,
            file_size,
            is_default,
            parse_status,
            created_at,
            updated_at
        FROM resume
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <!-- 更新提取的文本 -->
    <update id="updateExtractedText">
        UPDATE resume
        SET extracted_text = #{extractedText},
            parse_status = #{parseStatus},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 更新AI解析结果 -->
    <update id="updateParsedData">
        UPDATE resume
        SET parsed_data = #{parsedData},
            parse_status = #{parseStatus},
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 更新解析失败信息 -->
    <update id="updateParseError">
        UPDATE resume
        SET parse_error = #{parseError},
            parse_status = 3,
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 删除简历 -->
    <delete id="deleteById">
        DELETE FROM resume
        WHERE id = #{id}
    </delete>

    <!-- 清除用户的所有默认简历标记 -->
    <update id="clearDefaultByUserId">
        UPDATE resume
        SET is_default = 0,
            updated_at = NOW()
        WHERE user_id = #{userId}
    </update>

    <!-- 设置指定简历为默认 -->
    <update id="setDefaultById">
        UPDATE resume
        SET is_default = 1,
            updated_at = NOW()
        WHERE id = #{id}
    </update>

    <!-- 根据简历ID和用户ID查询简历（权限验证，包含所有字段） -->
    <select id="selectByIdAndUserId" resultMap="BaseResultMap">
        SELECT
            id,
            user_id,
            title,
            file_name,
            file_type,
            file_size,
            file_data,
            extracted_text,
            is_default,
            parse_status,
            parse_error,
            parsed_data,
            created_at,
            updated_at
        FROM resume
        WHERE id = #{id} AND user_id = #{userId}
    </select>

    <!-- 管理员查询简历列表（支持筛选，不包含file_data） -->
    <select id="selectAdminList" resultMap="ListResultMap">
        SELECT
            id,
            user_id,
            title,
            file_name,
            file_type,
            file_size,
            is_default,
            parse_status,
            created_at,
            updated_at
        FROM resume
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="fileName != null and fileName != ''">
                AND file_name LIKE CONCAT('%', #{fileName}, '%')
            </if>
            <if test="parseStatus != null">
                AND parse_status = #{parseStatus}
            </if>
            <if test="startDate != null">
                AND created_at &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND created_at &lt;= #{endDate}
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 管理员查询简历总数（支持筛选） -->
    <select id="countAdminList" resultType="int">
        SELECT COUNT(*)
        FROM resume
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
            <if test="fileName != null and fileName != ''">
                AND file_name LIKE CONCAT('%', #{fileName}, '%')
            </if>
            <if test="parseStatus != null">
                AND parse_status = #{parseStatus}
            </if>
            <if test="startDate != null">
                AND created_at &gt;= #{startDate}
            </if>
            <if test="endDate != null">
                AND created_at &lt;= #{endDate}
            </if>
        </where>
    </select>

</mapper>
