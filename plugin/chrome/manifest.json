{
  "manifest_version": 3,
  "name": "一念职达",
  "version": "1.0.0",
  "description": "智能求职助手 - 一键填写申请表单、优化简历、匹配岗位",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/fill.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "一念职达"
  },
  "permissions": [
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "popup/fill.html",
        "popup/styles/common.css",
        "popup/styles/fill.css",
        "icons/icon128.png"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js/content.js",
        "js/resumeInterface.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "externally_connectable": {
    "matches": [
      "http://192.168.1.144:*/*",
      "http://z6467e53.natappfree.cc/*",
      "http://localhost:*/*",
      "https://www.yinian.com/*"
    ]
  }
}
