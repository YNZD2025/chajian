{
  "manifest_version": 3,
  "name": "一念职达",
  "version": "1.0.0",
  "description": "智能求职助手 - 一键填写申请表单、优化简历、匹配岗位",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/profileMini.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "一念职达"
  },
  "permissions": [
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "resources": [
        "popup/fill.html",
        "popup/profile.html",
        "popup/history.html",
        "popup/settings.html",
        "popup/settingsMini.html",
        "popup/profileMini.html",
        "popup/edit-resume.html",
        "popup/login.html",
        "popup/change-password.html",
        "popup/privacy-settings.html",
        "popup/about.html",
        "popup/help.html",
        "popup/feedback.html",
        "popup/logo-small.png",
        "popup/styles/common.css",
        "popup/styles/fill.css",
        "popup/styles/simple-icons.css",
        "popup/scripts/transitions.js",
        "popup/scripts/statusPopup.js",
        "popup/scripts/settingsMini.js",
        "popup/scripts/profileMini.js",
        "case/css/resumeInterface.css",
        "case/data/简历列表数据.json",
        "icons/icon128.png",
        "test_data/resume.md"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "js2/messageBridge.js",
        "js2/configContent.js",
        "js2/content.js",
        "js2/resumeInterfaceTwo.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "js2/background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
  },
  "externally_connectable": {
    "matches": [
      "http://192.168.1.144:*/*",
      "http://z6467e53.natappfree.cc/*",
      "http://localhost:*/*",
      "https://applymind.cn/*",
      "http://g6fedde8.natappfree.cc/*",
      "https://test.applymind.cn/*"
    ]
  }
}
